# gpodder-fastapi-router environment variables
# Copy to `.env` and edit. Loaded automatically by GPodderConfig.

# --- Database ---
# SQLite (default):
GPODDER_DATABASE_URL=sqlite+aiosqlite:///./gpodder.db
# PostgreSQL:
# GPODDER_DATABASE_URL=postgresql+asyncpg://gpodder:gpodder@localhost:5432/gpodder

# Create tables on startup (idempotent CREATE TABLE IF NOT EXISTS)
GPODDER_CREATE_TABLES=true

# Log every SQL statement (noisy, dev only)
GPODDER_ECHO_SQL=false

# --- Public URLs (returned in /clientconfig.json) ---
GPODDER_BASE_URL=http://localhost:8000
GPODDER_FEEDSERVICE_URL=http://localhost:8000/feedservice
GPODDER_UPDATE_TIMEOUT=604800

# --- Auth / users ---
# Allow self-service POST /api/2/auth/{user}/register.json
GPODDER_ALLOW_REGISTRATION=true

# bcrypt cost factor (12 = ~250ms, raise for stronger / lower for tests)
GPODDER_BCRYPT_ROUNDS=12

# --- Dashboard ---
GPODDER_ENABLE_DASHBOARD=true
GPODDER_DASHBOARD_PREFIX=/dashboard

# Admin allow-list. JSON array. Empty = first registered user is admin.
GPODDER_ADMIN_USERNAMES=[]
# GPODDER_ADMIN_USERNAMES=["alice","ops"]
